# OpenRouter-Key für den Live-Modus (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=sk-or-...

# Optional: EU-Provider Melious (https://melious.ai) — Requests bleiben in der EU.
# Ohne diesen Key erscheinen keine melious:-Modelle im Dropdown; OpenRouter läuft unabhängig davon weiter.
MELIOUS_API_KEY=...
